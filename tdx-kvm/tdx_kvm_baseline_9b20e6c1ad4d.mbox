+}
+
 int main(int argc, char **argv)
 {
 	ksft_print_header();
@@ -395,8 +462,8 @@ int main(int argc, char **argv)
 		ksft_exit_skip("TDX is not supported by the KVM. Exiting.\n");
 
 	ksft_set_plan(1);
-	ksft_test_result(!run_in_new_process(&verify_upm_test),

+	u32 exit_reason;
 
 	switch (tdx->vp_enter_ret & TDX_SEAMCALL_STATUS_MASK) {
 	case TDX_SUCCESS:
@@ -822,7 +842,21 @@ static u32 tdx_to_vmx_exit_reason(struct kvm_vcpu *vcpu)
 		return -1u;

From 6e4d5114c5d3eea18c8eea70de930097dceaf7a1 Mon Sep 17 00:00:00 2001
From: Kai Huang <kai.huang@intel.com>
Date: Fri, 16 Aug 2024 23:21:08 +1200
Subject: [PATCH 124/165] KVM: TDX: Reset TDX private pages during reboot

Register TDX-specific reboot notifier to kill all TDX guests to reset
all TDX private pages that KVM manages to support kexec.

In kexec, the kernel needs to reset all TDX private pages back to normal
before booting to the second kernel when the platform has "partial write
machine check" erratum, otherwise the second kernel may see unexpected
machine check.

The core-kernel kexec code only resets PAMT but depends on the in-kernel
TDX users to reset the TDX private pages that they manage.  Register a
TDX-specific reboot notifier to kill all TDX guests to leverage the
existing kvm_destroy_vm() code path to reset all TDX private pages that
KVM manages.

Signed-off-by: Kai Huang <kai.huang@intel.com>
---
 arch/x86/kvm/vmx/tdx.c | 62 ++++++++++++++++++++++++++++++++++++++++++
 arch/x86/kvm/vmx/tdx.h |  7 +++++
 2 files changed, 69 insertions(+)

diff --git a/arch/x86/kvm/vmx/tdx.c b/arch/x86/kvm/vmx/tdx.c
index 6037475103cb..08c4bdf8646a 100644
--- a/arch/x86/kvm/vmx/tdx.c
+++ b/arch/x86/kvm/vmx/tdx.c
@@ -1,6 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0
 #include <linux/cpu.h>
 #include <linux/mmu_context.h>
+#include <linux/reboot.h>
 #include <asm/fpu/xcr.h>
 #include <asm/tdx.h>
 #include "capabilities.h"
@@ -29,6 +30,9 @@ static const struct tdx_sys_info *tdx_sysinfo;
 /* TDX KeyID pool */
 static DEFINE_IDA(tdx_guest_keyid_pool);
 
+static DEFINE_MUTEX(td_lock);
+static LIST_HEAD(td_list);
+
 static int tdx_guest_keyid_alloc(void)
 {
 	return ida_alloc_range(&tdx_guest_keyid_pool, tdx_guest_keyid_start,
@@ -530,6 +534,17 @@ void tdx_vm_free(struct kvm *kvm)
 
 	free_page((unsigned long)__va(kvm_tdx->tdr_pa));
 	kvm_tdx->tdr_pa = 0;
+
+	/*
+	 * Only remove TD from @td_list _after_ all TDX private pages
+	 * are actually freed and cleared, otherwise tdx_reboot_notify()
+	 * can return before all TDX privates are reset to normal which
+	 * may result in the CPU which is resetting TDX private pages
+	 * being stopped early before it finishes resetting all.
+	 */
+	mutex_lock(&td_lock);
+	list_del(&kvm_tdx->td_list);
+	mutex_unlock(&td_lock);
 }
 
 static int tdx_do_tdh_mng_key_config(void *param)
@@ -550,6 +565,12 @@ static int tdx_do_tdh_mng_key_config(void *param)
 
 int tdx_vm_init(struct kvm *kvm)
 {
+	/* Keep the task, KVM may need to explicitly kill TD when rebooting. */
+	to_kvm_tdx(kvm)->task = current;
+	mutex_lock(&td_lock);
+	list_add(&to_kvm_tdx(kvm)->td_list, &td_list);
+	mutex_unlock(&td_lock);
+
 	kvm->arch.has_private_mem = true;
 
 	/*
@@ -3295,6 +3316,31 @@ static int __init __do_tdx_bringup(void)
 	return r;
 }
 
+static int tdx_reboot_notify(struct notifier_block *nb,
+			     unsigned long code, void *unused)
+{
+	struct kvm_tdx *kvm_tdx;
+
+	/*
+	 * Explicitly send SIGKILL to kill all TDs to reset all TDX
+	 * guest private pages and secure-EPT pages.  Mark TD as buggy
+	 * doesn't guarantee userspace will just quit.
+	 */
+	mutex_lock(&td_lock);
+	list_for_each_entry(kvm_tdx, &td_list, td_list)
+		send_sig(SIGKILL, kvm_tdx->task, 1);
+	mutex_unlock(&td_lock);
+
+	/* Wait until all TDs are gone. */
+	while (!list_empty(&td_list))
+		cpu_relax();
+
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block tdx_reboot_nb = {
+	.notifier_call = tdx_reboot_notify,
+};
 static int __init __tdx_bringup(void)
 {
 	const struct tdx_sys_info_td_conf *td_conf;
@@ -3398,12 +3444,26 @@ static int __init __tdx_bringup(void)
 	if (r)
 		goto get_sysinfo_err;
 
+	/*
+	 * If the platform has "partial write machine check" erratum,
+	 * KVM needs to use MOVDIR64B to reset all TDX private pages
+	 * (guest private pages and secure-EPT pages) to support kexec,
+	 * otherwise the second kernel may see unexpected machine check.
+	 */
+	if (boot_cpu_has_bug(X86_BUG_TDX_PW_MCE)) {
+		r = register_reboot_notifier(&tdx_reboot_nb);
+		if (r)
+			goto reboot_notifier_err;
+	}
+
 	/*
 	 * Leave hardware virtualization enabled after TDX is enabled
 	 * successfully.  TDX CPU hotplug depends on this.
 	 */
 	return 0;
 
+reboot_notifier_err:
+	free_kvm_tdx_cap();
 get_sysinfo_err:
 	__do_tdx_cleanup();
 tdx_bringup_err:
@@ -3414,6 +3474,8 @@ static int __init __tdx_bringup(void)
 void tdx_cleanup(void)
 {
 	if (enable_tdx) {
+		if (boot_cpu_has_bug(X86_BUG_TDX_PW_MCE))
+			unregister_reboot_notifier(&tdx_reboot_nb);
 		free_kvm_tdx_cap();
 		__do_tdx_cleanup();
 		kvm_disable_virtualization();
diff --git a/arch/x86/kvm/vmx/tdx.h b/arch/x86/kvm/vmx/tdx.h
index c6407e9caa5a..9dca0f01bc32 100644
--- a/arch/x86/kvm/vmx/tdx.h
+++ b/arch/x86/kvm/vmx/tdx.h
@@ -5,6 +5,10 @@
 #include "tdx_errno.h"
 
 #ifdef CONFIG_INTEL_TDX_HOST
+
+#include <linux/list.h>
+#include <linux/sched.h>
+
 void tdx_bringup(void);
 void tdx_cleanup(void);
 
@@ -17,6 +21,9 @@ extern bool enable_tdx;
 struct kvm_tdx {
 	struct kvm kvm;
 
+	struct task_struct *task;
+	struct list_head td_list;
+
 	unsigned long tdr_pa;
 	unsigned long *tdcs_pa;
 
-- 

+	ret = tdg_vp_vmcall_ve_request_mmio_read(mmio_test_addr, 1, &data);
 	if (ret)
 		tdx_test_fatal(ret);
 	if (data != 0x12)
 		tdx_test_fatal(1);
 
-	ret = tdg_vp_vmcall_ve_request_mmio_read(TDX_MMIO_TEST_ADDR, 2, &data);
+	ret = tdg_vp_vmcall_ve_request_mmio_read(mmio_test_addr, 2, &data);
 	if (ret)
 		tdx_test_fatal(ret);
 	if (data != 0x1234)
 		tdx_test_fatal(2);
 

@@ -733,6 +741,8 @@ fastpath_t tdx_vcpu_run(struct kvm_vcpu *vcpu, bool force_immediate_exit)
 	vcpu->arch.regs_avail &= ~VMX_REGS_LAZY_LOAD_SET;

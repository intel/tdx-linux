+}
+EXPORT_SYMBOL_GPL(tdh_mem_sept_remove);
+
+u64 tdh_mem_track(u64 tdr)
+{
+	struct tdx_module_args args = {
+		.rcx = tdr,
+	};
+
+	return seamcall(TDH_MEM_TRACK, &args);
+}

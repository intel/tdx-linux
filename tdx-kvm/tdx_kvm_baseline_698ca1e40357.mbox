@@ -2837,6 +2837,11 @@ static int tdx_gmem_post_populate(struct kvm *kvm, gfn_t gfn, kvm_pfn_t pfn,
 
 	read_lock(&kvm->mmu_lock);
 
+	if (unlikely(vcpu->arch.mmu->root.hpa == INVALID_PAGE)) {
+		ret = -EINVAL;

 {
+    X86CPU *x86cpu = X86_CPU(cpu);
+
     object_property_set_bool(OBJECT(cpu), "pmu", false, &error_abort);
     object_property_set_bool(OBJECT(cpu), "lmce", false, &error_abort);
+
+    x86cpu->enable_cpuid_0x1f = true;
 }
 

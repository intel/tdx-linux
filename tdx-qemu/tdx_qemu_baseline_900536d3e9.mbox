---
 hw/i386/pc_q35.c           |  2 ++
 hw/i386/x86.c              | 49 +++++++++++++++++++++++++++++++++
 hw/pci-host/q35.c          | 40 ++++++++++++++++++++-------
 include/hw/i386/pc.h       |  1 +

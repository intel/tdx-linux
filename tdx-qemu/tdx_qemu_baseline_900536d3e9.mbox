 target/i386/kvm/kvm.c |   4 +
 target/i386/kvm/tdx.c | 263 ++++++++++++++++++++++++++++++++++++++++++
 target/i386/kvm/tdx.h |   2 +
 4 files changed, 285 insertions(+)


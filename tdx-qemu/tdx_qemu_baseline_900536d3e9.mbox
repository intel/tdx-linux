From 0829405822d68f5382fba263491174fd2057de3a Mon Sep 17 00:00:00 2001
From: Chenyi Qiang <chenyi.qiang@intel.com>
Date: Tue, 28 Mar 2023 09:55:23 +0800
Subject: [PATCH 60/61] hw/vfio: implement convert_mem_attr() callback in
 vfio_memory_listener

VFIO normally registers the whole region with the kernel and pin all
pages, which is incompatible with restricted memory region. Restricted
memory region exclusively represents two types of memory, i.e. shared
memory and private memory. Shared memory is accessible an can be mapped
in IOMMU while private memory is un-mmaped and can't be DMA-mapped in
IOMMU.

Register the VFIO callback of convert_mem_attr() in memory region
listener, so that the DMA mapping can be dynamically updated once the
memory attribute get converted.

Signed-off-by: Chenyi Qiang <chenyi.qiang@intel.com>
---
 hw/vfio/common.c | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/hw/vfio/common.c b/hw/vfio/common.c
index bbbe19388d..64a51cef1f 100644
--- a/hw/vfio/common.c
+++ b/hw/vfio/common.c
@@ -1390,6 +1390,18 @@ static void vfio_listener_log_sync(MemoryListener *listener,
     }
 }
 
+static void vfio_listener_convert_mem_attr(MemoryListener *listener,
+                                           MemoryRegionSection *section,
+                                           bool shared)
+{
+    VFIOContainerBase *bcontainer = container_of(listener, VFIOContainerBase, listener);
+
+    if (shared)
+        vfio_notify_populate_generic(bcontainer, section, 1ULL << ctz64(bcontainer->pgsizes));
+    else
+        vfio_notify_discard_generic(bcontainer, section);
+}
+
 const MemoryListener vfio_memory_listener = {
     .name = "vfio",
     .region_add = vfio_listener_region_add,
@@ -1397,6 +1409,7 @@ const MemoryListener vfio_memory_listener = {
     .log_global_start = vfio_listener_log_global_start,
     .log_global_stop = vfio_listener_log_global_stop,
     .log_sync = vfio_listener_log_sync,
+    .convert_mem_attr = vfio_listener_convert_mem_attr,
 };
 
 void vfio_reset_handler(void *opaque)
